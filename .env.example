# Copy to .env.test / .env.dev / .env.prod and fill in. Never commit real values.
# Switch profile inside Claude Code with: /env test   (tool: switch_environment)

# DEV | TEST | PROD  -> PROD turns on the "CONFIRM PROD" guard for every write
ORACLE_ENV_NAME=TEST
# Pod base URL only, no path. e.g. https://xxxx-test.fa.ocs.oraclecloud.com
ORACLE_BASE_URL=
# basic | oauth
ORACLE_AUTH_MODE=basic
# Fusion release of this pod, e.g. 26D
ORACLE_RELEASE=26D

# --- basic auth (dedicated user, e.g. AI_SCM_AGENT) ---
ORACLE_USERNAME=
ORACLE_PASSWORD=

# --- oauth client credentials (recommended long term) ---
ORACLE_OAUTH_TOKEN_URL=
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=
ORACLE_SCOPE=

# Optional: ADF REST framework version header (default 4)
# ORACLE_REST_FRAMEWORK_VERSION=4
